    "ComfyEasySenseNovaDownloadModel": {
      "display_name": "SenseNova-U1 模型下载",
      "inputs": {
        "model_preset": {"display_name": "模型预设", "tooltip": "选择官方模型；选择自定义后填写仓库 ID 和模型子文件夹。"},
        "repo_id": {"display_name": "仓库 ID", "tooltip": "仅自定义仓库时生效；选择官方预设时忽略。"},
        "model_subfolder": {"display_name": "模型子文件夹", "tooltip": "仅自定义仓库时生效；官方预设自动使用仓库名。"},
        "download_source": {"display_name": "下载源", "tooltip": "选择 Hugging Face 或 hf-mirror。"},
        "revision": {"display_name": "版本", "tooltip": "可选 branch、tag 或 commit。"},
        "token": {"display_name": "访问令牌", "tooltip": "仅私有或受限仓库需要。"},
        "disable_tls": {"display_name": "关闭 TLS 校验", "tooltip": "仅在可信网络排障时开启。"},
        "disable_xet": {"display_name": "关闭 Xet", "tooltip": "使用普通 HTTP 下载，提高镜像兼容性。"},
        "force_download": {"display_name": "强制重新下载", "tooltip": "忽略已有模型并重新下载。"}
      },
      "outputs": {
        "模型路径": {"display_name": "模型路径"},
        "下载状态": {"display_name": "下载状态"}
      }
    },
    "ComfyEasySenseNovaLoadModel": {
      "display_name": "SenseNova-U1 模型加载",
      "inputs": {
        "model_name": {"display_name": "本地模型", "tooltip": "models/SenseNova 下检测到的模型子目录。"},
        "model_path": {"display_name": "模型路径", "tooltip": "连接下载节点输出时优先使用该路径。"},
        "device": {"display_name": "设备", "tooltip": "auto 使用 ComfyUI 当前计算设备。"},
        "storage_precision": {"display_name": "存储精度", "tooltip": "权重加载和驻留的数据类型。"},
        "compute_precision": {"display_name": "计算精度", "tooltip": "推理自动混合精度；auto 跟随存储精度。float32 计算要求 float32 存储。"},
        "attention_backend": {"display_name": "注意力机制", "tooltip": "自动、FlashAttention 或 PyTorch SDPA。"},
        "vram_mode": {"display_name": "显存模式", "tooltip": "选择整模常驻或逐层卸载。"},
        "device_map": {"display_name": "多卡映射", "tooltip": "使用 Accelerate 将权重分片到多个设备。"},
        "max_memory": {"display_name": "设备内存上限", "tooltip": "例如 0=20GiB,1=20GiB,cpu=64GiB。"},
        "reload_model": {"display_name": "重新加载模型", "tooltip": "忽略模型缓存并重新实例化。"}
      },
      "outputs": {
        "SenseNova 模型": {"display_name": "SenseNova 模型"},
        "模型信息": {"display_name": "模型信息"}
      }
    },
